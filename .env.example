# ==========================================
# CONFIGURAÇÃO DO TELEGRAM BOT
# ==========================================
# Crie um bot no Telegram com o @BotFather para obter o TOKEN.
# Obtenha seu Chat ID conversando com @userinfobot ou @myidbot no Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_POLL_INTERVAL_SECONDS=5
TELEGRAM_HISTORY_LIMIT=5

# Exibir alertas no console (útil para desenvolvimento ou quando o bot ainda não está configurado)
CONSOLE_ALERTS=true

# ==========================================
# CONFIGURAÇÕES DO SERVIDOR
# ==========================================
HOST=127.0.0.1
PORT=8050
DEFAULT_GRACE_MINUTES=15
CHECK_INTERVAL_SECONDS=15

# ==========================================
# MCP APP (CHATGPT / CODEX)
# ==========================================
# O servidor MCP é somente leitura e consulta a API REST do Sentinel.
SENTINEL_API_URL=http://127.0.0.1:8050
# Use 0.0.0.0 somente para acesso pela rede local. Para uso apenas nesta
# máquina, mantenha 127.0.0.1.
MCP_HOST=127.0.0.1
MCP_PORT=8787

# Monitor proativo: persiste a fila e só emite quando houver mudança relevante.
MCP_PROACTIVE_ENABLED=false
MCP_PROACTIVE_INTERVAL_SECONDS=60
# Opcional: webhook HTTPS que receberá eventos sentinel.attention.changed.
MCP_ALERT_WEBHOOK_URL=
# Opcional: assina o corpo em X-Sentinel-Signature com HMAC-SHA256.
MCP_ALERT_WEBHOOK_SECRET=
